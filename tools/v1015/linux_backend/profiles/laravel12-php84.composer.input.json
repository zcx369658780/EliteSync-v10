{
  "$schema": "https://getcomposer.org/schema.json",
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "description": "The skeleton application for the Laravel framework.",
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "minimum-stability": "stable",
  "name": "laravel/laravel",
  "prefer-stable": true,
  "require": {
    "6tail/lunar-php": "^1.4",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-hash": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pcre": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-session": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.9",
    "php": "~8.4.0",
    "workerman/workerman": "^5.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.1",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^11.0.1"
  },
  "scripts": {},
  "type": "project"
}
