  # Validate both before either replacement; .NET setters receive typed strings.
  $body.set_Item('started',$projected['started'])
  $body.set_Item('finished',$projected['finished'])
- return (New-ReceiptParser).Serialize($body)
+ try{
+  return (New-ReceiptParser).Serialize($body)
+ }catch{
+  $aggregateFailure=$_
