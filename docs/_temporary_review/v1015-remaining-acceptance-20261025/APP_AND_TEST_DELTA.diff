+
+  void install() {
+    messenger.setMockMethodCallHandler(_nativeChannel, (call) async {
+      final args = Map<String, dynamic>.from(call.arguments as Map);
+      final id = args['rendererId'] as String;
+      switch (call.method) {
+        case 'startAudioRenderer':
